# Copy to backend/.env and fill in your key.
# Gemini is the default when this is set.

GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides:
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI still works if you prefer:
# OPENAI_API_KEY=sk-...
# VISION_PROVIDER=openai
# VISION_MODEL=gpt-4o-mini

# Persistence:
# - Local / Docker Compose: leave unset → SQLite under DATA_DIR (volume-backed)
# - DigitalOcean App Platform: set DATABASE_URL to Managed Postgres
#   (host disk is ephemeral; goals will disappear on every deploy with SQLite only)
# DATABASE_URL=postgresql://user:pass@host:25060/defaultdb?sslmode=require
# DATA_DIR=/data
# DATABASE_PATH=/data/tracker.db
